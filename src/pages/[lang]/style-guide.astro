---
import Layout from "../../layouts/Layout.astro";
import { languages, ui, type Lang } from "../../i18n";
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const vi = lang === "vi";
---

<Layout lang={lang} title={ui[lang].styleGuide} path="style-guide/" noindex>
  <header class="page-heading">
    <p class="eyebrow">Toward Less</p>
    <h1>{ui[lang].styleGuide}</h1>
    <p>{ui[lang].styleDescription}</p>
  </header>
  <div class="prose">
    <h2>{vi ? "Kiểu chữ" : "Typography"}</h2>
    <p>
      {vi
        ? "Trang này dùng để kiểm tra giao diện, không phải bài viết. Nội dung không xuất hiện trong kết quả tìm kiếm hay sơ đồ trang."
        : "This page is for checking the design. It is not a blog post and is excluded from search and the sitemap."}
    </p>
    <h3 lang="vi">Kiểm tra dấu tiếng Việt</h3>
    <p lang="vi">
      Đọc thử đoạn văn này trên điện thoại và máy tính để kiểm tra cỡ chữ, khoảng cách dòng và
      dấu tiếng Việt: ă â ê ô ơ ư đ — Ắ Ằ Ẳ Ẵ Ặ Ấ Ầ Ẩ Ẫ Ậ Ế Ề Ể Ễ Ệ Ố Ồ Ổ Ỗ Ộ Ớ Ờ Ở Ỡ Ợ Ứ Ừ Ử Ữ Ự.
    </p>
    <p>
      <strong>{vi ? "Chữ đậm" : "Bold text"}</strong>,{" "}
      <em>{vi ? "chữ nghiêng" : "italic text"}</em>,{" "}
      <a href="#code-sample">{vi ? "liên kết" : "a link"}</a>,{" "}
      {vi ? "và chữ Pāli" : "and Pāli text"}: sati, paññā, dukkha, anattā.
    </p>
    <blockquote>
      <p>
        {vi
          ? "Đây là đoạn mẫu để kiểm tra cách trình bày trích dẫn. Khi trích dẫn trong bài viết, cần ghi rõ nguồn."
          : "This is sample text for testing blockquote styling. Include the source when quoting someone in an article."}
      </p>
    </blockquote>
    <h2>{vi ? "Màu sắc" : "Colours"}</h2>
    <div class="swatches">
      <div class="swatch" style="background:var(--paper)">Paper · --paper</div>
      <div class="swatch" style="background:var(--surface)">Surface · --surface</div>
      <div class="swatch" style="background:var(--accent);color:var(--paper)">Accent · --accent</div>
    </div>
    <h2 id="code-sample">{vi ? "Mã nguồn" : "Code"}</h2>
    <p>
      {vi ? "Kiểm tra mã trong dòng như" : "Check inline code such as"}{" "}
      <code>translationKey</code>{vi ? " và khối mã bên dưới." : " and the block below."}
    </p>
    <pre
      tabindex="0"
      aria-label={vi ? "Mã minh họa" : "Code example"}
    ><code>{'const languages = ["en", "vi"];\nconst defaultLanguage = languages[0];\n// This intentionally long sample line tests horizontal scrolling inside a code block without widening the page. '.repeat(2)}</code></pre>
    <h2>{vi ? "Bảng" : "Tables"}</h2>
    <table>
      <thead><tr><th>{vi ? "Thành phần" : "Element"}</th><th>{vi ? "Thiết lập" : "Setting"}</th></tr></thead>
      <tbody>
        <tr><td>{vi ? "Nội dung" : "Body"}</td><td>Noto Serif</td></tr>
        <tr><td>{vi ? "Giao diện" : "Interface"}</td><td>Be Vietnam Pro</td></tr>
        <tr><td>{vi ? "Bố cục" : "Layout"}</td><td>{vi ? "Một cột" : "Single column"}</td></tr>
      </tbody>
    </table>
  </div>
</Layout>
