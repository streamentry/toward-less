---
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import { getPosts } from "../../lib/posts";
import { languages, ui, localePath, type Lang } from "../../i18n";
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const posts = await getPosts(lang);
---

<Layout lang={lang}>
  <header class="hero">
    <p class="eyebrow">{t.notebook}</p>
    <h1><span>{t.lineOne}</span><span>{t.lineTwo}</span></h1>
    <p class="intro">{t.intro}</p>
    <p class="byline">{t.by} <a href={localePath(lang, "about/")}>Chánh Niệm</a></p>
    <div class="subject-line">{Object.values(t.topics).map((topic) => <span>{topic}</span>)}</div>
  </header>
  <section aria-labelledby="recent-heading">
    <div class="section-heading">
      <h2 id="recent-heading">{t.latest}</h2><a href={localePath(lang, "posts/")}
        >{t.allArticles} <span aria-hidden="true">↗</span></a>
    </div>
    {
      posts.length ? (
        <ul class="post-list">
          {posts.slice(0, 5).map((post) => (
            <PostCard post={post} />
          ))}
        </ul>
      ) : (
        <p class="empty">{t.empty}</p>
      )
    }
  </section>
</Layout>
