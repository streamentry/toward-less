---
import Layout from "../../layouts/Layout.astro";
import { languages, ui, aboutCopy, localePath, type Lang } from "../../i18n";
import { AUTHOR } from "../../site";
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const copy = aboutCopy[lang];
---

<Layout lang={lang} title={t.about} description={t.aboutDescription} path="about/" section="about">
  <article data-pagefind-body>
    <header class="page-heading">
      <p class="eyebrow" data-pagefind-ignore>{t.about} · {AUTHOR}</p>
      <h1 data-pagefind-meta="title">{t.aboutTitle}</h1>
    </header>
    <div class="prose">
      <p class="about-lead">{copy.lead}</p>
      <p>{copy.purpose}</p>
      <p>{copy.translationNote}</p>
      <p data-pagefind-ignore>
        <a href={localePath(lang, "posts/")}>{copy.browse}</a> {copy.follow}{" "}
        <a href={localePath(lang, "rss.xml")}>RSS</a>.
      </p>
    </div>
  </article>
</Layout>
