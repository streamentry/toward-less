---
import Layout from "../../layouts/Layout.astro";
import { languages, ui, localePath, type Lang } from "../../i18n";
import { AUTHOR } from "../../site";
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
---

<Layout lang={lang} title={t.about} description={t.aboutDescription} path="about/" section="about">
  <article data-pagefind-body>
    <header class="page-heading">
      <p class="eyebrow" data-pagefind-ignore>{t.about} · {AUTHOR}</p>
      <h1 data-pagefind-meta="title">{t.aboutTitle}</h1>
    </header>
    <div class="prose">
      {
        lang === "en" ? (
          <>
            <p class="about-lead">
              I’m {AUTHOR}. I build software. I use this blog to write about technology,
              family life, and what I’m learning from Buddhist practice.
            </p>
            <p>
              I chose Toward Less as a reminder not to take on too much or hold on to an
              opinion just because it’s mine.
            </p>
            <p>
              I write in English and Vietnamese. Some posts have a translation; others don’t.
            </p>
            <p data-pagefind-ignore>
              <a href={localePath(lang, "posts/")}>Browse the articles</a> or follow via{" "}
              <a href={localePath(lang, "rss.xml")}>RSS</a>.
            </p>
          </>
        ) : (
          <>
            <p class="about-lead">
              Tôi là {AUTHOR}. Tôi làm phần mềm. Trang này là nơi tôi ghi lại những điều đang
              tìm hiểu về công nghệ, đời sống gia đình và Phật pháp.
            </p>
            <p>
              Tôi chọn tên Toward Less để nhắc mình bớt ôm đồm và bớt cố giữ một ý kiến chỉ vì
              đó là ý kiến của mình.
            </p>
            <p>
              Tôi viết bằng tiếng Việt và tiếng Anh. Không phải bài nào cũng có bản dịch.
            </p>
            <p data-pagefind-ignore>
              <a href={localePath(lang, "posts/")}>Xem các bài viết</a> hoặc theo dõi qua{" "}
              <a href={localePath(lang, "rss.xml")}>RSS</a>.
            </p>
          </>
        )
      }
    </div>
  </article>
</Layout>
