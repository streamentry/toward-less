---
import Layout from "../../layouts/Layout.astro";
import { languages, ui, pagefindMessages, localePath, withBase, type Lang } from "../../i18n";
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
---

<Layout
  lang={lang}
  title={t.search}
  description={t.searchDescription}
  path="search/"
  section="search"
  noindex
>
  <link slot="head" rel="stylesheet" href={withBase("pagefind/pagefind-ui.css")} />
  <header class="page-heading"><h1>{t.search}</h1><p>{t.searchDescription}</p></header>
  <div
    id="search"
    data-base={withBase("pagefind/")}
    data-placeholder={t.searchPlaceholder}
    data-lang={lang}
  >
  </div>
  <p id="search-error" hidden>
    {t.searchUnavailable}
    <a href={localePath(lang, "posts/")}>{t.allArticles}</a>
  </p>
  <noscript><p>{t.noScript} <a href={localePath(lang, "posts/")}>{t.allArticles}</a></p></noscript>
  <script
    is:inline
    define:vars={{ base: withBase("pagefind/"), lang, translations: pagefindMessages[lang] }}
  >
    const script = document.createElement("script");
    script.src = base + "pagefind-ui.js";
    script.onload = () => {
      try {
        new window.PagefindUI({
          element: "#search",
          bundlePath: base,
          showSubResults: true,
          showImages: false,
          translations,
        });
      } catch (error) {
        document.getElementById("search-error").hidden = false;
        // eslint-disable-next-line no-console -- retain the Pagefind failure for browser debugging.
        console.error(error);
      }
    };
    script.onerror = () => {
      document.getElementById("search-error").hidden = false;
    };
    document.head.append(script);
  </script>
</Layout>
