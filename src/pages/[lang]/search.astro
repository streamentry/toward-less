---
import Layout from "../../layouts/Layout.astro";
import { languages, ui, localePath, withBase, type Lang } from "../../i18n";
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = ui[lang];
---
<Layout lang={lang} title={t.search} description={t.searchDescription} path="search/" section="search" noindex>
  <link slot="head" rel="stylesheet" href={withBase("pagefind/pagefind-ui.css")} />
  <header class="page-heading"><h1>{t.search}</h1><p>{t.searchDescription}</p></header>
  <div id="search" data-base={withBase("pagefind/")} data-placeholder={t.searchPlaceholder} data-lang={lang}></div>
  <p id="search-error" hidden>{t.searchUnavailable} <a href={localePath(lang, "posts/")}>{t.allArticles}</a></p>
  <noscript><p>{t.noScript} <a href={localePath(lang, "posts/")}>{t.allArticles}</a></p></noscript>
  <script is:inline define:vars={{ base: withBase("pagefind/"), lang, placeholder: t.searchPlaceholder }}>
    const script = document.createElement("script");
    script.src = base + "pagefind-ui.js";
    script.onload = () => {
      try {
        const translations = lang === "vi" ? { placeholder, clear_search: "Xóa", load_more: "Xem thêm", search_label: "Tìm kiếm", filters_label: "Bộ lọc", zero_results: "Không tìm thấy kết quả cho [SEARCH_TERM]", many_results: "[COUNT] kết quả cho [SEARCH_TERM]", one_result: "Một kết quả cho [SEARCH_TERM]", searching: "Đang tìm…" } : { placeholder };
        new window.PagefindUI({ element: "#search", bundlePath: base, showSubResults: true, showImages: false, translations });
      } catch (error) { document.getElementById("search-error").hidden = false; console.error(error); }
    };
    script.onerror = () => { document.getElementById("search-error").hidden = false; };
    document.head.append(script);
  </script>
</Layout>
