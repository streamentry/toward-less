---
import { render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Mark from "../../../components/Mark.astro";
import {
  getPosts,
  postPath,
  dateLabel,
  readingMinutes,
  entryNumbers,
  type Post,
} from "../../../lib/posts";
import { ui, languageTags, localePath, tagLabel, type Lang } from "../../../i18n";
import { AUTHOR } from "../../../site";
interface Alternate {
  lang: Lang;
  href: string;
}
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { lang: post.data.lang, slug: post.data.slug },
    props: { post },
  }));
}
const { post } = Astro.props as { post: Post };
const { lang } = post.data;
const t = ui[lang];
const { Content, headings } = await render(post);
const number = (await entryNumbers(lang)).get(post.id);
const toc = headings.filter((heading) => heading.depth === 2).slice(0, 12);
const alternates: Alternate[] = (await getPosts())
  .filter((item) => item.data.translationKey === post.data.translationKey)
  .map((item) => ({ lang: item.data.lang, href: postPath(item) }));
// Keep the inline translation hint useful and quiet; the language menu offers all 18.
// Prefer Vietnamese from English articles, and English from every other locale.
const preferredTranslation = lang === "en" ? "vi" : "en";
const translated =
  alternates.find((item) => item.lang === preferredTranslation) ??
  alternates.find((item) => item.lang !== lang);
const canonical = new URL(postPath(post), Astro.site).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  inLanguage: languageTags[lang],
  datePublished: post.data.pubDatetime.toISOString(),
  dateModified: (post.data.modDatetime ?? post.data.pubDatetime).toISOString(),
  author: {
    "@type": post.data.authorType,
    name: post.data.author,
    ...(post.data.author === AUTHOR
      ? { url: new URL(localePath(lang, "about/"), Astro.site).href }
      : {}),
  },
  publisher: { "@type": "Person", name: AUTHOR },
  ...(post.data.sourceURL ? { isBasedOn: post.data.sourceURL } : {}),
  mainEntityOfPage: canonical,
};
---

<Layout
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  author={post.data.author}
  section="posts"
  alternates={alternates}
  article
>
  <Fragment slot="head"
    ><meta property="article:published_time" content={post.data.pubDatetime.toISOString()} /><meta
      property="article:modified_time"
      content={(post.data.modDatetime ?? post.data.pubDatetime).toISOString()}
    /><script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    /></Fragment
  >
  <article class="article" data-pagefind-body>
    <div class="reading-progress" aria-hidden="true" data-pagefind-ignore></div>
    <header class="article-header">
      <div class="tags" data-pagefind-ignore>
        {
          post.data.tags.map((tag) => (
            <a href={localePath(lang, `tags/${tag}/`)}>{tagLabel(tag, lang)}</a>
          ))
        }
      </div>
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      <p class="article-deck" data-pagefind-meta="description">{post.data.description}</p>
      <div class="article-meta" data-pagefind-ignore>
        {
          number && (
            <span class="entry-number" aria-hidden="true">
              {number}
            </span>
          )
        }
        <span>{post.data.author}</span>
        <time datetime={post.data.pubDatetime.toISOString()}
          >{dateLabel(post.data.pubDatetime, lang)}</time
        >
        <span>{readingMinutes(post)} {t.minute}</span>
        {
          post.data.modDatetime && (
            <p>
              {t.updated}:{" "}
              <time datetime={post.data.modDatetime.toISOString()}>
                {dateLabel(post.data.modDatetime, lang)}
              </time>
            </p>
          )
        }
        {
          translated && (
            <p>
              {t.translated}:{" "}
              <a
                href={translated.href}
                lang={languageTags[translated.lang]}
                hreflang={languageTags[translated.lang]}
              >
                {ui[translated.lang].language}
              </a>
            </p>
          )
        }
      </div>
    </header>
    {
      toc.length > 1 && (
        <details class="toc" data-pagefind-ignore>
          <>
            <summary>{t.toc}</summary>
            <ol>
              {toc.map((heading) => (
                <li data-depth={heading.depth}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </>
        </details>
      )
    }
    <div class="prose"><Content /></div>
  </article>
  <div class="article-mark" aria-hidden="true"><Mark /></div>
  <div class="reader-controls" data-pagefind-ignore>
    <div class="segmented" role="group" aria-label={t.textSize}>
      <span aria-hidden="true">{t.textSize}</span>
      <button class="control" type="button" data-reading="text-minus" aria-label={t.textSmaller}
        >A−</button
      >
      <button class="control" type="button" data-reading="text-plus" aria-label={t.textLarger}
        >A+</button
      >
    </div>
    <div class="segmented" role="group" aria-label={t.measure}>
      <span aria-hidden="true">{t.measure}</span>
      <button
        class="control"
        type="button"
        data-reading="measure-minus"
        aria-label={t.measureNarrow}>−</button
      >
      <button class="control" type="button" data-reading="measure-plus" aria-label={t.measureWide}
        >+</button
      >
    </div>
  </div>
  <nav class="article-end" aria-label={t.afterArticle}>
    <a href={localePath(lang, "posts/")}>← {t.back}</a><a href={localePath(lang, "rss.xml")}
      >{t.rss}</a
    >
  </nav>
  <script is:inline>
    (() => {
      const toc = document.querySelector("details.toc");
      if (!toc) return;
      const wide = window.matchMedia("(min-width: 72rem)");
      // On wide screens the table of contents is a rail in the margin:
      // open it there, close it again when the viewport narrows.
      const syncOpen = () => {
        toc.open = wide.matches;
      };
      syncOpen();
      wide.addEventListener("change", syncOpen);
      // Scroll-spy: mark the section link for the heading nearest the top.
      const links = new Map(
        [...toc.querySelectorAll("a")].map((a) => [a.getAttribute("href")?.slice(1), a]),
      );
      const headings = [...document.querySelectorAll(".prose h2[id]")].filter((h) =>
        links.has(h.id),
      );
      if (!headings.length || !("IntersectionObserver" in window)) return;
      let current = null;
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) current = entry.target.id;
          }
          for (const [id, link] of links) {
            if (id === current) link.setAttribute("aria-current", "true");
            else link.removeAttribute("aria-current");
          }
        },
        { rootMargin: "-15% 0px -75% 0px" },
      );
      for (const heading of headings) observer.observe(heading);
    })();
  </script>
  <script src="../../../scripts/reading.ts"></script>
</Layout>
