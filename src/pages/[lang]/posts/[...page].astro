---
import type { GetStaticPaths, Page } from "astro";
import Layout from "../../../layouts/Layout.astro";
import PostCard from "../../../components/PostCard.astro";
import Pagination from "../../../components/Pagination.astro";
import { getPosts, PAGE_SIZE, type Post } from "../../../lib/posts";
import { languages, ui, localePath, type Lang } from "../../../i18n";
export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return languages.flatMap((lang) =>
    paginate(
      posts.filter((post) => post.data.lang === lang),
      { params: { lang }, pageSize: PAGE_SIZE },
    ),
  );
}) satisfies GetStaticPaths;
const lang = Astro.params.lang as Lang;
const { page } = Astro.props as { page: Page<Post> };
const t = ui[lang];
const path = `posts/${page.currentPage === 1 ? "" : `${page.currentPage}/`}`;
const alternates = (
  await Promise.all(
    languages.map(async (language) => ({
      lang: language,
      href: localePath(language, path),
      count: (await getPosts(language)).length,
    })),
  )
)
  .filter(({ count }) => page.currentPage === 1 || count > (page.currentPage - 1) * PAGE_SIZE)
  .map(({ lang: language, href }) => ({ lang: language, href }));
---

<Layout
  lang={lang}
  title={page.currentPage === 1 ? t.articles : `${t.articles} · ${page.currentPage}`}
  description={t.archiveDescription}
  path={path}
  section="posts"
  alternates={alternates}
>
  <header class="page-heading">
    <p class="label">Toward Less</p><h1>{t.articles}</h1><p>{t.archiveDescription}</p><a
      href={localePath(lang, "tags/")}>{t.topicsTitle}</a
    >
  </header>
  {
    page.data.length ? (
      <ul class="post-list">
        {page.data.map((post) => (
          <PostCard post={post} />
        ))}
      </ul>
    ) : (
      <p class="empty">{t.empty}</p>
    )
  }
  <Pagination
    lang={lang}
    current={page.currentPage}
    last={page.lastPage}
    prev={page.url.prev}
    next={page.url.next}
  />
</Layout>
