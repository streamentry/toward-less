---
import type { GetStaticPaths, Page } from "astro";
import Layout from "../../../layouts/Layout.astro";
import PostCard from "../../../components/PostCard.astro";
import { getPosts, type Post } from "../../../lib/posts";
import { languages, ui, localePath, otherLanguage, type Lang } from "../../../i18n";
export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return languages.flatMap(lang => paginate(posts.filter(post => post.data.lang === lang), { params: { lang }, pageSize: 8 }));
}) satisfies GetStaticPaths;
const lang = Astro.params.lang as Lang;
const { page } = Astro.props as { page: Page<Post> };
const t = ui[lang];
const path = `posts/${page.currentPage === 1 ? "" : `${page.currentPage}/`}`;
const other = otherLanguage(lang);
const otherCount = (await getPosts(other)).length;
const alternates = [{ lang, href: localePath(lang, path) }];
if (page.currentPage === 1 || otherCount > (page.currentPage - 1) * 8) alternates.push({ lang: other, href: localePath(other, path) });
---
<Layout lang={lang} title={page.currentPage === 1 ? t.articles : `${t.articles} · ${page.currentPage}`} description={t.archiveDescription} path={path} section="posts" alternates={alternates} alternateHref={localePath(other, "posts/")}>
  <header class="page-heading"><p class="eyebrow">Toward Less</p><h1>{t.articles}</h1><p>{t.archiveDescription}</p><a href={localePath(lang, "tags/")}>{t.topicsTitle}</a></header>
  {page.data.length ? <ul class="post-list">{page.data.map(post => <PostCard post={post} />)}</ul> : <p class="empty">{t.empty}</p>}
  {page.lastPage > 1 && <nav class="pagination" aria-label={lang === "vi" ? "Phân trang" : "Pagination"}>
    {page.url.prev ? <a rel="prev" href={page.url.prev}>← {t.previous}</a> : <span />}
    <span class="page-count">{t.page} {page.currentPage} {t.of} {page.lastPage}</span>
    {page.url.next ? <a rel="next" href={page.url.next}>{t.next} →</a> : <span />}
  </nav>}
</Layout>
