---
import Layout from "../../../layouts/Layout.astro";
import { getPosts } from "../../../lib/posts";
import { languages, ui, localePath, tagLabel, type Lang } from "../../../i18n";
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const posts = await getPosts(lang);
const tags = [...new Set(posts.flatMap(post => post.data.tags))].sort();
---
<Layout lang={lang} title={ui[lang].topicsTitle} path="tags/" section="posts">
  <header class="page-heading"><h1>{ui[lang].topicsTitle}</h1></header>
  <ul class="topic-list">{tags.map(tag => <li><a href={localePath(lang, `tags/${tag}/`)}>{tagLabel(tag, lang)} <span>({posts.filter(post => post.data.tags.includes(tag)).length})</span></a></li>)}</ul>
  {!tags.length && <p class="empty">{ui[lang].empty}</p>}
</Layout>
