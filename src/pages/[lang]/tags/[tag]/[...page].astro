---
import type { GetStaticPaths, Page } from "astro";
import Layout from "../../../../layouts/Layout.astro";
import PostCard from "../../../../components/PostCard.astro";
import Pagination from "../../../../components/Pagination.astro";
import { getPosts, PAGE_SIZE, type Post } from "../../../../lib/posts";
import { languages, ui, localePath, tagLabel, type Lang } from "../../../../i18n";
export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return languages.flatMap((lang) => {
    const localPosts = posts.filter((post) => post.data.lang === lang);
    return [...new Set(localPosts.flatMap((post) => post.data.tags))].flatMap((tag) =>
      paginate(
        localPosts.filter((post) => post.data.tags.includes(tag)),
        { params: { lang, tag }, pageSize: PAGE_SIZE },
      ),
    );
  });
}) satisfies GetStaticPaths;
const lang = Astro.params.lang as Lang;
const tag = Astro.params.tag as string;
const { page } = Astro.props as { page: Page<Post> };
const t = ui[lang];
const path = `tags/${tag}/${page.currentPage === 1 ? "" : `${page.currentPage}/`}`;
const alternates = (
  await Promise.all(
    languages.map(async (language) => ({
      lang: language,
      href: localePath(language, path),
      count: (await getPosts(language)).filter((post) => post.data.tags.includes(tag)).length,
    })),
  )
)
  .filter(({ count }) => count > (page.currentPage - 1) * PAGE_SIZE)
  .map(({ lang: language, href }) => ({ lang: language, href }));
---

<Layout
  lang={lang}
  title={`${tagLabel(tag, lang)}${page.currentPage > 1 ? ` · ${page.currentPage}` : ""}`}
  path={path}
  section="posts"
  alternates={alternates}
>
  <header class="page-heading">
    <p class="label"><a href={localePath(lang, "tags/")}>{t.topicsTitle}</a></p><h1>
      {tagLabel(tag, lang)}
    </h1>
  </header>
  <ul class="post-list">{page.data.map((post) => <PostCard post={post} />)}</ul>
  <Pagination
    lang={lang}
    current={page.currentPage}
    last={page.lastPage}
    prev={page.url.prev}
    next={page.url.next}
  />
</Layout>
