---
import Layout from "../layouts/Layout.astro";
import { languages, languageNames, languageTags, localePath } from "../i18n";
---

<Layout lang="en" title="Page not found" noindex>
  <header class="page-heading">
    <p class="eyebrow">404</p><h1>This page is not here.</h1><p>
      The address may have changed. Return to the notebook and start again.
    </p>
  </header>
  <p><a href={localePath("en")}>Return home</a></p>
  <nav aria-label="Choose language">
    <ul>{languages.map((language) => <li><a href={localePath(language)} lang={languageTags[language]}>{languageNames[language]}</a></li>)}</ul>
  </nav>
</Layout>
