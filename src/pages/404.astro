---
import Layout from "../layouts/Layout.astro";
import { languages, languageNames, languageTags, localePath, ui } from "../i18n";
const t = ui.en;
---

<Layout lang="en" title={t.notFound} noindex>
  <header class="page-heading">
    <p class="label">404</p><h1>{t.notFound}</h1><p>{t.notFoundText}</p>
  </header>
  <p><a href={localePath("en")}>{t.home}</a></p>
  <nav aria-label={t.languageMenu}>
    <ul class="topic-list">
      {
        languages.map((language) => (
          <li>
            <a href={localePath(language)} lang={languageTags[language]}>
              {languageNames[language]}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</Layout>
