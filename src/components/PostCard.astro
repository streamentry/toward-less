---
import { postPath, dateLabel, readingMinutes, type Post } from "../lib/posts";
import { ui, localePath, tagLabel } from "../i18n";
const { post } = Astro.props as { post: Post };
const { lang } = post.data;
---
<li class="post-card">
  <div class="post-meta"><time datetime={post.data.pubDatetime.toISOString()}>{dateLabel(post.data.pubDatetime, lang)}</time><span aria-hidden="true">·</span><span>{readingMinutes(post)} {ui[lang].minute}</span></div>
  <h2><a href={postPath(post)}>{post.data.title}</a></h2>
  <p>{post.data.description}</p>
  <div class="tags">{post.data.tags.map(tag => <a href={localePath(lang, `tags/${tag}/`)}>{tagLabel(tag, lang)}</a>)}</div>
</li>
