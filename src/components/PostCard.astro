---
import { postPath, dateLabel, readingMinutes, entryNumbers, type Post } from "../lib/posts";
import { ui, localePath, tagLabel } from "../i18n";
const { post } = Astro.props as { post: Post };
const { lang } = post.data;
const number = (await entryNumbers(lang)).get(post.id);
---

<li class="entry">
  <div class="entry-meta">
    {
      number && (
        <span class="entry-number" aria-hidden="true">
          {number}
        </span>
      )
    }
    <time datetime={post.data.pubDatetime.toISOString()}
      >{dateLabel(post.data.pubDatetime, lang)}</time
    >
    <span>{readingMinutes(post)} {ui[lang].minute}</span>
  </div>
  <div class="entry-body">
    <h2 class="entry-title"><a href={postPath(post)}>{post.data.title}</a></h2>
    <p class="entry-dek">{post.data.description}</p>
    <div class="tags">
      {
        post.data.tags.map((tag) => (
          <a href={localePath(lang, `tags/${tag}/`)}>{tagLabel(tag, lang)}</a>
        ))
      }
    </div>
  </div>
</li>
