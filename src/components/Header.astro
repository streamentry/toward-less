---
import Mark from "./Mark.astro";
import { ui, languages, languageNames, languageTags, localePath, type Lang } from "../i18n";
interface Props {
  lang: Lang;
  section?: string;
  alternates?: { lang: Lang; href: string }[];
}
const { lang, section = "", alternates = [] } = Astro.props;
const t = ui[lang];
const alternateMap = new Map(alternates.map((alternate) => [alternate.lang, alternate.href]));
---

<header class="masthead" data-pagefind-ignore>
  <div class="masthead-inner">
    <a class="brand" href={localePath(lang)} aria-label={`Toward Less · ${t.home}`}
      ><Mark /><span>Toward Less</span></a
    >
    <nav class="main-nav" aria-label={t.nav}>
      <a href={localePath(lang, "posts/")} aria-current={section === "posts" ? "page" : undefined}
        >{t.articles}</a
      >
      <a href={localePath(lang, "about/")} aria-current={section === "about" ? "page" : undefined}
        >{t.about}</a
      >
      <a href={localePath(lang, "search/")} aria-current={section === "search" ? "page" : undefined}
        >{t.search}</a
      >
    </nav>
    <div class="header-tools">
      <details class="language-menu">
        <summary aria-label={`${t.languageMenu}: ${languageNames[lang]}`} title={languageNames[lang]}>
          {lang.toUpperCase()}
        </summary>
        <nav aria-label={t.languageMenu}>
          {languages.map((language) => (
            <a
              href={alternateMap.get(language) ?? localePath(language)}
              lang={languageTags[language]}
              hreflang={languageTags[language]}
              aria-current={language === lang ? "page" : undefined}
              data-language-choice
              data-language={language}
            >
              {languageNames[language]}
            </a>
          ))}
        </nav>
      </details>
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        hidden
        aria-label={t.theme}
        data-label={t.theme}
        data-auto={t.themeAuto}
        data-light={t.themeLight}
        data-dark={t.themeDark}
      >
        <svg width="17" height="17" viewBox="0 0 20 20" aria-hidden="true"
          ><circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.5"
          ></circle><path d="M10 3a7 7 0 0 1 0 14Z" fill="currentColor"></path></svg
        >
        <span id="theme-label" class="sr-only">{t.themeAuto}</span>
      </button>
    </div>
  </div>
</header>


<script is:inline>
  for (const link of document.querySelectorAll("[data-language-choice]")) {
    link.addEventListener("click", () => {
      const language = link.getAttribute("data-language");
      if (!language) return;

      try {
        localStorage.setItem("toward-less-language", language);
      } catch {
        // Language switching must still work when storage is unavailable.
      }
    });
  }
</script>
