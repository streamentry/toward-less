---
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ui, languages, languageTags, isRtl, localePath, withBase, type Lang } from "../i18n";
import { AUTHOR } from "../site";
import "../styles/global.css";
interface Alternate {
  lang: Lang;
  href: string;
}
interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  author?: string;
  path?: string;
  section?: string;
  alternates?: Alternate[];
  noindex?: boolean;
  article?: boolean;
}
const {
  lang,
  title,
  description = ui[Astro.props.lang].intro,
  author = AUTHOR,
  path = "",
  section,
  noindex = false,
  article = false,
} = Astro.props;
const pageTitle = title ? `${title} — Toward Less` : `Toward Less — ${AUTHOR}`;
// Astro emits the special error page as 404.html even with trailingSlash: always.
const canonicalPath = Astro.url.pathname.endsWith("/404/")
  ? withBase("404.html")
  : Astro.url.pathname;
const canonical = new URL(canonicalPath, Astro.site).href;
const alternates =
  Astro.props.alternates ??
  languages.map((language) => ({ lang: language, href: localePath(language, path) }));
const absolute = (value: string) => new URL(value, Astro.site).href;
const ogImage = absolute(withBase("og.png"));
---

<!doctype html>
<html
  lang={languageTags[lang]}
  dir={isRtl(lang) ? "rtl" : "ltr"}
  data-copy={ui[lang].copyCode}
  data-copied={ui[lang].copiedCode}
>
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XRS285VL7X"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-XRS285VL7X");
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    {
      !noindex &&
        alternates.map((item) => (
          <link rel="alternate" hreflang={languageTags[item.lang]} href={absolute(item.href)} />
        ))
    }
    {
      !noindex && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={absolute(alternates.find((item) => item.lang === "en")?.href ?? Astro.url.pathname)}
        />
      )
    }
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="sitemap" href={withBase("sitemap.xml")} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Toward Less · ${ui[lang].language}`}
      href={localePath(lang, "rss.xml")}
    />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content="Toward Less" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={languageTags[lang].replace("-", "_")} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Toward Less — Less clinging. Clearer seeing." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f7f5ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171c19" media="(prefers-color-scheme: dark)" />
    <Font cssVariable="--font-reading" />
    <Font cssVariable="--font-interface" />
    <script is:inline>
      (() => {
        let preference = "auto";
        try {
          preference = localStorage.getItem("toward-less-theme") || "auto";
        } catch {}
        if (!["light", "sepia", "dark", "auto"].includes(preference)) preference = "auto";
        const theme =
          preference === "auto"
            ? matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : preference;
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.preference = preference;
      })();
    </script>
    <script is:inline>
      // Apply saved reading preferences (text size, line length) before paint.
      (() => {
        try {
          const saved = JSON.parse(localStorage.getItem("toward-less-reading") || "{}");
          const textSteps = [0.94, 1, 1.08, 1.16];
          const measureSteps = [0.9, 1, 1.1];
          if (typeof saved.t === "number" && textSteps[saved.t] !== undefined)
            document.documentElement.style.setProperty(
              "--reader-scale",
              String(textSteps[saved.t]),
            );
          if (typeof saved.m === "number" && measureSteps[saved.m] !== undefined)
            document.documentElement.style.setProperty(
              "--measure-scale",
              String(measureSteps[saved.m]),
            );
        } catch {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui[lang].skip}</a>
    <Header lang={lang} section={section} alternates={alternates} />
    <main id="main" class="shell" tabindex="-1"><slot /></main>
    <Footer lang={lang} alternates={alternates} />
    <script src="../scripts/theme.ts"></script>
    <script is:inline>
      // Code blocks: add a language label and a copy button to each one.
      (() => {
        const copyLabel = document.documentElement.dataset.copy || "Copy";
        const copiedLabel = document.documentElement.dataset.copied || "Copied";
        for (const pre of document.querySelectorAll(".prose pre")) {
          const code = pre.querySelector("code");
          const lang =
            pre.getAttribute("data-language") || (code?.className.match(/language-(\S+)/) || [])[1];
          if (lang) {
            const label = document.createElement("span");
            label.className = "code-label";
            label.textContent = lang;
            pre.prepend(label);
          }
          const button = document.createElement("button");
          button.type = "button";
          button.className = "code-copy";
          button.textContent = copyLabel;
          button.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(code?.textContent ?? pre.textContent ?? "");
              button.textContent = copiedLabel;
              setTimeout(() => {
                button.textContent = copyLabel;
              }, 1500);
            } catch {}
          });
          pre.append(button);
        }
      })();
    </script>
  </body>
</html>
